{
  "name": "mm3-seed-rpg",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "data:export": "python -I tools/export/export_g_data.py",
    "data:validate": "tsx tools/export/validate-data.ts",
    "data:maps": "python -I tools/export/export_maps.py",
    "data:towns": "tsx tools/export/export-town-blueprints.ts",
    "assets:report": "tsx tools/assets/inventory.ts",
    "assets:textures": "tsx tools/assets/build-textures.ts",
    "assets:models": "tsx tools/assets/build-models.ts",
    "assets:originals": "tsx tools/assets/build-models.ts --original",
    "assets:audio": "tsx tools/assets/build-audio.ts",
    "assets:build": "tsx tools/assets/build.ts",
    "golden:update": "tsx tools/dev/update-golden.ts",
    "check:chrome": "tsx tools/dev/chrome-golden.ts",
    "check:render": "tsx tools/dev/check-render.ts",
    "sheet:monsters": "tsx tools/dev/monster-sheet.ts",
    "sheet:projectiles": "tsx tools/dev/sheet-projectiles.ts",
    "check:effects": "tsx tools/dev/check-effects.ts",
    "check:inn": "tsx tools/dev/check-inn.ts",
    "check:models": "tsx tools/dev/check-models.ts",
    "check:options": "tsx tools/dev/check-options.ts",
    "sheet:tiles": "tsx tools/dev/tile-sheet.ts",
    "bench": "tsx tools/dev/bench.ts",
    "balance": "tsx tools/dev/balance.ts",
    "check:campaign": "tsx tools/dev/campaign-sweep.ts"
  },
  "devDependencies": {
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/extensions": "4.5.1",
    "@gltf-transform/functions": "4.5.1",
    "@types/node": "26.6.5",
    "ffmpeg-static": "5.3.0",
    "meshoptimizer": "1.3.0",
    "obj2gltf": "3.2.0",
    "puppeteer-core": "25.14.0",
    "sharp": "0.35.5",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "@babylonjs/core": "9.31.0",
    "@babylonjs/loaders": "9.31.0",
    "@fontsource/almendra": "5.3.0",
    "@fontsource/cinzel": "5.3.0",
    "zod": "4.6.7"
  }
}
