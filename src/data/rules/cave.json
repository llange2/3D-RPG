{
  "tierBonus": 0,
  "rules": [
    { "id": "exit", "kind": "transfer", "anchor": "exit", "count": { "perMap": [1, 1] }, "params": { "mode": "poi_exit" } },
    { "id": "boss_guard", "kind": "spawn", "anchor": "bossRoom", "count": { "perMap": [1, 1] }, "params": { "boss": true, "group": "=1+rand(0,tier)" } },
    {
      "id": "boss_chest",
      "kind": "treasure",
      "anchor": "bossRoomEdge",
      "count": { "perMap": [1, 2] },
      "params": { "level": "=min(8,tier+1)", "gold": "=tier*200+rand(0,200)", "items": "=1+rand(0,1)" }
    },
    {
      "id": "chest_deadend",
      "kind": "treasure",
      "anchor": "deadEnd",
      "when": { "minDepth": 150 },
      "count": { "perMap": [3, 6] },
      "params": { "level": "=tier", "gold": "=tier*80+rand(0,110)", "items": "=rand(0,1)" }
    },
    {
      "id": "chest_chamber",
      "kind": "treasure",
      "anchor": "roomEdge",
      "when": { "excludeEntranceRoom": true, "minRoomSize": 40 },
      "count": { "perMap": [2, 4] },
      "params": { "level": "=tier", "gold": "=tier*70+rand(0,100)", "items": "=rand(0,1)" }
    },
    {
      "id": "trap_before_chest",
      "kind": "trap",
      "anchor": "beforeTreasure",
      "count": { "chance": 350 },
      "variants": [
        { "weight": 3, "params": { "trap": "pit", "damage": "=tier*3+rand(1,4)" } },
        { "weight": 1, "params": { "trap": "spring", "damage": "=tier*4+rand(1,5)" } }
      ]
    },
    { "id": "trap_pit", "kind": "trap", "anchor": "corridor", "when": { "minDepth": 200 }, "count": { "perMap": [1, 4] }, "params": { "trap": "pit", "damage": "=tier*3+rand(1,4)" } },
    { "id": "trap_chamber", "kind": "trap", "anchor": "roomEdge", "when": { "excludeEntranceRoom": true, "minRoomSize": 40 }, "count": { "perMap": [3, 7] }, "params": { "trap": "pit", "damage": "=tier*3+rand(1,4)" } },
    { "id": "ambush", "kind": "ambush", "anchor": "corridor", "when": { "minDepth": 250 }, "count": { "perMap": [1, 3] }, "params": { "group": "=1+rand(0,tier)" } },
    {
      "id": "monsters_chamber",
      "kind": "spawn",
      "anchor": "roomCenter",
      "when": { "excludeEntranceRoom": true },
      "count": { "chance": 1000 },
      "params": { "boss": false, "group": "=1+rand(0,tier+1)" }
    },
    {
      "id": "shrine",
      "kind": "shrine",
      "anchor": "roomEdge",
      "when": { "excludeEntranceRoom": true, "minRoomSize": 60 },
      "count": { "perMap": [0, 1] },
      "variants": [
        { "weight": 2, "params": { "effect": "resist", "amount": "=2+tier" } },
        { "weight": 3, "params": { "effect": "heal", "amount": "=tier*20" } }
      ]
    },
    { "id": "decor_chamber", "kind": "decor", "anchor": "roomEdge", "when": { "minRoomSize": 30 }, "count": { "perMap": [10, 22] } },
    { "id": "decor_hall", "kind": "decor", "anchor": "roomCenter", "when": { "excludeEntranceRoom": true, "minRoomSize": 40 }, "count": { "chance": 120 } },
    { "id": "lore", "kind": "lore", "anchor": "deadEnd", "count": { "perMap": [0, 2] }, "params": { "pool": "cave", "line": "=rand(0,19)" } },
    {
      "id": "lore_chamber",
      "kind": "lore",
      "anchor": "roomEdge",
      "when": { "excludeEntranceRoom": true, "minRoomSize": 40 },
      "count": { "perMap": [0, 1] },
      "params": { "pool": "cave", "line": "=rand(0,19)" }
    },
    { "id": "breakable", "kind": "breakable_wall", "anchor": "wallBetween", "count": { "perMap": [0, 2] } }
  ]
}
